{
  "id": "sihttp.test",
  "type": "application",
  "value": {
    "public": false,
    "clangd": true,
    "use": ["sijson", "sireflect"]
  },
  "lang.c": {
    "c-standard": "c23",
    "${os windows}": {
      "c-standard": "c11",
      "cflags": ["/FS", "/Dsihttp_EXPORTS"]
    },
    "include": ["../include", "../src"]
  },
  "test": {
    "testsuites": [
      {
        "id": "siformat",
        "testcases": [
          "basic",
          "empty"
        ]
      },
      {
        "id": "request",
        "testcases": [
          "parse_get_query",
          "parse_post_body"
        ]
      },
      {
        "id": "route",
        "testcases": [
          "exact",
          "param",
          "method_not_allowed"
        ]
      },
      {
        "id": "response",
        "testcases": [
          "default_status",
          "custom_status",
          "json_content_type",
          "cors_headers"
        ]
      },
      {
        "id": "server",
        "testcases": [
          "config",
          "socket_roundtrip",
          "poll_idle",
          "poll_roundtrip",
          "not_found",
          "cors_preflight",
          "dispatch_exact",
          "dispatch_param",
          "dispatch_body",
          "dispatch_not_found",
          "dispatch_method_not_allowed"
        ]
      }
    ]
  }
}
