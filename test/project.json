{
  "id": "sihttp.test",
  "type": "application",
  "value": {
    "public": false,
    "clangd": true,
    "use": [
      "sijson",
      "sireflect",
      "sicore"
    ]
  },
  "lang.c": {
    "c-standard": "c23",
    "${os windows}": {
      "c-standard": "c11",
      "cflags": [
        "/FS",
        "/Dsihttp_EXPORTS"
      ]
    },
    "include": [
      "../include",
      "../src"
    ]
  },
  "test": {
    "testsuites": [
      {
        "id": "siformat",
        "testcases": [
          "basic",
          "empty"
        ]
      },
      {
        "id": "request",
        "testcases": [
          "parse_get_query",
          "parse_post_body",
          "headers_and_query",
          "path_numbers",
          "uri_decoding",
          "malformed_http",
          "signed_numbers"
        ]
      },
      {
        "id": "route",
        "testcases": [
          "exact",
          "param",
          "method_not_allowed",
          "multiple_and_rollback",
          "precedence_and_validation"
        ]
      },
      {
        "id": "response",
        "testcases": [
          "default_status",
          "custom_status",
          "json_content_type",
          "cors_headers",
          "binary_keeps_null_bytes",
          "helpers",
          "status_and_cors",
          "custom_headers"
        ]
      },
      {
        "id": "server",
        "testcases": [
          "config",
          "socket_roundtrip",
          "poll_idle",
          "poll_roundtrip",
          "not_found",
          "cors_preflight",
          "dispatch_exact",
          "dispatch_param",
          "dispatch_body",
          "dispatch_bytes",
          "dispatch_not_found",
          "dispatch_method_not_allowed",
          "dispatch_features",
          "options_and_cors",
          "network_body_limit",
          "methods_and_allow",
          "network_malformed",
          "dispatch_header_validation",
          "uri_parity",
          "try_route_validation"
        ]
      }
    ]
  }
}
